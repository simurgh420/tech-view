generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlogPost {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  excerpt        String
  content        String
  coverImageUrl  String?
  readingMinutes Int
  publishedAt    DateTime?
  updatedAt      DateTime    @updatedAt
  status         PostStatus  @default(PUBLISHED)
  videoUrls      String[]
  authorId       String?
  author         User?       @relation("UserPosts", fields: [authorId], references: [id])
  comments       Comment[]
  tags           TagOnPost[]

  @@index([publishedAt])
  @@index([status])
}

model Tag {
  id    String      @id @default(cuid())
  name  String      @unique
  slug  String      @unique
  posts TagOnPost[]
}

model TagOnPost {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    String
  rating    Int      @default(0)
  authorId  String?
  author    User?    @relation("UserComments", fields: [authorId], references: [id])
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([rating])
  @@index([authorId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
}

model Category {
  id                  String     @id @default(cuid())
  title               String
  slug                String     @unique
  icon                String?
  order               Int        @default(0)
  isActive            Boolean    @default(true)
  parentId            String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  parent              Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[] @relation("CategoryHierarchy")
  products            Product[]
  subCategoryProducts Product[]  @relation("SubCategoryProducts")
  attributes          CategoryAttribute[]

  @@index([isActive])
  @@index([parentId])
  @@index([order])
}

model Product {
  id                 String         @id @default(cuid())
  title              String
  slug               String         @unique
  description        String
  brandId            String
  categoryId         String
  subCategoryId      String?
  price              Decimal        @db.Decimal(12, 2)
  discountPrice      Decimal?       @db.Decimal(12, 2)
  discountPercentage Int?
  isDiscounted       Boolean        @default(false)
  isFeatured         Boolean        @default(false)
  keyFeatures        String[]       @default([])
  isNew              Boolean        @default(false)
  stockQuantity      Int            @default(0)
  rating             Decimal?       @db.Decimal(3, 2)
  reviewCount        Int            @default(0)
  thumbnail          String?
  images             String[]       @default([])
  variants           Json           @default("[]")
  colors             Json           @default("[]")
  status             ProductStatus  @default(PUBLISHED)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  publishedAt        DateTime?
  cartItems          CartItem[]
  brand              Brand          @relation(fields: [brandId], references: [id])
  category           Category       @relation(fields: [categoryId], references: [id])
  subCategory        Category?      @relation("SubCategoryProducts", fields: [subCategoryId], references: [id])
  prices             ProductPrice[]
  reviews            Review[]
  comments           ProductComment[]
  wishlistItems      WishlistItem[]
  specifications     ProductSpecification[]

  @@index([brandId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isDiscounted])
  @@index([isFeatured])
  @@index([isNew])
  @@index([price])
  @@index([rating])
  @@index([status])
  @@index([publishedAt])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  key       String
  value     String
  groupName String?
  attributeId String?
  attribute   Attribute? @relation(fields: [attributeId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key, value])
  @@index([key, value])
  @@index([productId, key])
  @@index([attributeId])
}
model ProductPrice {
  id        String    @id @default(cuid())
  productId String
  currency  Currency
  type      PriceType @default(BASE)
  amount    Decimal   @db.Decimal(12, 2)
  validFrom DateTime?
  validTo   DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, currency, type])
}

enum AttributeType {
  TEXT     // متن آزاد، غیرقابل فیلتر معمولا (مثلا توضیح دوربین)
  NUMBER   // عدد قابل مرتب‌سازی/رنج (مثلا رم، حافظه)
  BOOLEAN  // دارد/ندارد
  ENUM     // یکی از چند مقدار از پیش تعریف‌شده (مثلا رنگ، شبکه)
}

model Attribute {
  id        String              @id @default(cuid())
  key       String              @unique   // ثابت، انگلیسی، هرگز تغییر نمی‌کنه: "processor", "ram", ...
  label     String                        // لیبل فارسی نمایشی: "پردازنده"
  type      AttributeType       @default(TEXT)
  unit      String?                       // "GB", "mAh", "Hz", ...
  order     Int                 @default(0)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  options            AttributeOption[]
  categoryAttributes CategoryAttribute[]
  specifications     ProductSpecification[]

  @@index([isActive])
}

// فقط برای type = ENUM استفاده می‌شه: لیست مقادیر مجاز
// مثلا برای Attribute با key="network": ["4G", "5G", "3G"]
model AttributeOption {
  id          String    @id @default(cuid())
  attributeId String
  value       String
  order       Int       @default(0)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
}

// مشخص می‌کنه کدوم Attribute برای کدوم دسته‌بندی معتبره
// و آیا در پنل فیلتر سایت نمایش داده بشه یا نه
model CategoryAttribute {
  id           String    @id @default(cuid())
  categoryId   String
  attributeId  String
  isFilterable Boolean   @default(true)   // معادل همون enabled فعلی توی کد
  isRequired   Boolean   @default(false)  // آیا در فرم ثبت محصول اجباریه
  order        Int       @default(0)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([categoryId])
  @@index([attributeId])
}
model Review {
  id        String   @id @default(cuid())
  productId String
  authorId  String?
  rating    Int
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [authorId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, authorId])
  @@index([productId])
  @@index([rating])
}

model User {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  name            String
  phone           String?
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  role            UserRole         @default(USER)
  banExpires      DateTime?
  banReason       String?
  banned          Boolean?         @default(false)
  blogPosts       BlogPost[]       @relation("UserPosts")
  cart            Cart?
  comments        Comment[]        @relation("UserComments")
  contactMessages ContactMessage[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  accounts        Account[]
  sessions        Session[]
  orders          Order[]
  productComments   ProductComment[]
  @@map("Users")
}

model Session {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accountId             String
  providerId            String
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  userId                String
  accessToken           String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  identifier String
  value      String
  expiresAt  DateTime

  @@index([identifier])
  @@map("verifications")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  priceAtAdd Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}


model Order {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  total         Int
  status        OrderStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]
  address       OrderAddress?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])

  productId String
  title     String
  price     Int
  quantity  Int
}

model OrderAddress {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])

  fullName    String
  phone       String
  city        String
  postalCode  String
  address     String
}


model ProductComment {
  id        String           @id @default(cuid())
  content   String
  productId String
  authorId  String?
  parentId  String?
  depth     Int              @default(0)

  status    CommentStatus    @default(APPROVED)
  deletedAt                  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    User?            @relation(fields: [authorId], references: [id])
  parent    ProductComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ProductComment[] @relation("CommentReplies")

  @@index([productId])
  @@index([parentId])
  @@index([authorId])
  @@index([status])
}
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}
model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Currency {
  USD
  EUR
  IRR
}

enum PriceType {
  BASE
  DISCOUNT
}

enum UserRole {
  ADMIN
  USER
  SUPER_ADMIN
}
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}
